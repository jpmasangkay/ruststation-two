# Step 2.5 PCSX2 diagnostic probe (outside frozen GS_RENDER_GATE_SUITES until Step 4).
# Shallow Z interpolation probe (G-012) exposing Z rounding & precision via ZTST=GEQUAL overlays.
# Top band: small 12-bit Z (1000..1017 across W=281 px, ~16.5 px per Z unit).
# Bottom band: 25-bit Z near 2^24 (0x01000000..0x01000013 across W=281 px, ~14.8 px per Z unit),
# where f32 has ULP=2.0 and cannot resolve odd Z integers cleanly.
surface 0 5 PSMCT32 320 240

reg PRMODECONT 1
reg FRAME_1 0x00000000_00050000
reg ZBUF_1 0x00000000_00000096
reg XYOFFSET_1 0x00008000_00008000
reg SCISSOR_1 0x00EF0000_013F0000
reg TEST_1 0x00030000

# 1. Clear full 320x240 framebuffer (#000000, A=0x80) and Z=0
reg PRIM 6
reg RGBAQ 0x3F800000_80000000
reg XYZ2 0x00000000_80008000
reg XYZ2 0x00000000_8F009400

# 2. Region A base quad [20..301, 20..100] via 2 triangles, dark blue #204080, Z = 1000..1017
reg PRIM 0x000B
reg RGBAQ 0x3F800000_80804020
reg XYZ2 0x000003E8_81408140
reg XYZ2 0x000003F9_814092D0
reg XYZ2 0x000003E8_86408140
reg XYZ2 0x000003F9_814092D0
reg XYZ2 0x000003F9_864092D0
reg XYZ2 0x000003E8_86408140

# 3. Region B base quad [20..301, 125..205] via 2 triangles, dark green #206040, Z = 0x01000000..0x01000013
reg RGBAQ 0x3F800000_80406020
reg XYZ2 0x01000000_87D08140
reg XYZ2 0x01000013_87D092D0
reg XYZ2 0x01000000_8CD08140
reg XYZ2 0x01000013_87D092D0
reg XYZ2 0x01000013_8CD092D0
reg XYZ2 0x01000000_8CD08140

# 4. Switch depth test to GEQUAL (ZTE=1, ZTST=2 -> 0x00050000) and draw constant-Z Sprite test strips
reg TEST_1 0x00050000
reg PRIM 6

# Region A GEQUAL strips: Z = 1004, 1008, 1012, 1015
reg RGBAQ 0x3F800000_8040E0F0
reg XYZ2 0x00000000_81A08140
reg XYZ2 0x000003EC_828092D0

reg RGBAQ 0x3F800000_802080F0
reg XYZ2 0x00000000_82C08140
reg XYZ2 0x000003F0_83A092D0

reg RGBAQ 0x3F800000_80F0E040
reg XYZ2 0x00000000_83E08140
reg XYZ2 0x000003F4_84C092D0

reg RGBAQ 0x3F800000_80E040F0
reg XYZ2 0x00000000_85008140
reg XYZ2 0x000003F7_85E092D0

# Region B GEQUAL strips: even/odd Z = 0x01000004, 0x01000009, 0x0100000E, 0x01000011
reg RGBAQ 0x3F800000_8040E0F0
reg XYZ2 0x00000000_88308140
reg XYZ2 0x01000004_891092D0

reg RGBAQ 0x3F800000_802080F0
reg XYZ2 0x00000000_89508140
reg XYZ2 0x01000009_8A3092D0

reg RGBAQ 0x3F800000_80F0E040
reg XYZ2 0x00000000_8A708140
reg XYZ2 0x0100000E_8B5092D0

reg RGBAQ 0x3F800000_80E040F0
reg XYZ2 0x00000000_8B908140
reg XYZ2 0x01000011_8C7092D0
