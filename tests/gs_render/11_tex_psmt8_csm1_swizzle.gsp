# Step 3a GS Render Gate #11 / PCSX2 Checkpoint (b): PSMT8 + CSM1 with CLUT entries 8..23 distinct (`0x08<->0x10` swizzle, sprites only).
surface 0 5 PSMCT32 320 240

reg PRMODECONT 1
reg FRAME_1 0x0000_0000_0005_0000
reg ZBUF_1 0x0000_0001_0000_0096
reg XYOFFSET_1 0x0000_8000_0000_8000
reg SCISSOR_1 0x00EF_0000_013F_0000
reg TEST_1 0x0003_0000

# 1. Upload PSMCT32 CLUT (16x2 = 32 entries -> 8 QWC) at CBP=0x0680 (page 52), bw=1
qwc 0x1000_0000_0000_8004 0x0000_0000_0000_000E
qwc 0x0001_0680_0000_0000 0x50
qwc 0x0000_0000_0000_0000 0x51
qwc 0x0000_0002_0000_0010 0x52
qwc 0x0000_0000_0000_0000 0x53

# In CSM1 8-bit CLUT, VRAM (0..7, y=0) -> idx 0..7; VRAM (8..15, y=0) -> idx 16..23;
# VRAM (0..7, y=1) -> idx 8..15; VRAM (8..15, y=1) -> idx 24..31.
# We make CLUT idx 8..15 green/cyan and CLUT idx 16..23 orange/red so 0x08<->0x10 is unambiguous.
qwc 0x0800_0000_0000_8008 0x0000_0000_0000_0000
# VRAM row y=0, x=0..7 -> CLUT 0..7 (blue shades)
qwc32 0x80A03030 0x80B03030 0x80C03030 0x80D03030
qwc32 0x80E03030 0x80F03030 0x80F84040 0x80FF5050
# VRAM row y=0, x=8..15 -> CLUT 16..23 (orange/red shades)
qwc32 0x801020F0 0x801038F0 0x801050F0 0x801068F0
qwc32 0x801080F0 0x801098F0 0x8010B0F0 0x8010C8F0
# VRAM row y=1, x=0..7 -> CLUT 8..15 (green/cyan shades)
qwc32 0x8020F010 0x8038F010 0x8050F010 0x8068F010
qwc32 0x8080F010 0x8098F010 0x80B0F010 0x80C8F010
# VRAM row y=1, x=8..15 -> CLUT 24..31 (purple shades)
qwc32 0x80D030C0 0x80D038D0 0x80D040E0 0x80D048F0
qwc32 0x80E050D0 0x80E060E0 0x80E070F0 0x80F080FF

# 2. Upload 16x4 PSMT8 texture (`DPSM=0x13`) at TBP0=0x0640 (page 50), bw=1 (64 bytes = 4 QWC)
qwc 0x1000_0000_0000_8004 0x0000_0000_0000_000E
qwc 0x1301_0640_0000_0000 0x50
qwc 0x0000_0000_0000_0000 0x51
qwc 0x0000_0004_0000_0010 0x52
qwc 0x0000_0000_0000_0000 0x53

qwc 0x0800_0000_0000_8004 0x0000_0000_0000_0000
# texel row 0: indices 0..15 (blue 0..7 then green 8..15)
qwc32 0x03020100 0x07060504 0x0B0A0908 0x0F0E0D0C
# texel row 1: indices 16..31 (orange 16..23 then purple 24..31)
qwc32 0x13121110 0x17161514 0x1B1A1918 0x1F1E1D1C
# texel row 2: indices 8..23 (all 16 distinct swapped entries across x=0..15)
qwc32 0x0B0A0908 0x0F0E0D0C 0x13121110 0x17161514
# texel row 3: indices 23..8 descending
qwc32 0x14151617 0x10111213 0x0C0D0E0F 0x08090A0B

# 3. Clear 320x240 framebuffer to black (#000000, A=0x80)
reg PRIM 6
reg RGBAQ 0x3F800000_80000000
reg XYZ2 0x0000_0000_8000_8000
reg XYZ2 0x0000_0000_8F00_9400

# 4. Bind PSMT8 + CSM1 + Decal (TFX=1, TCC=1), TW=4 (16), TH=2 (4), CBP=0x680, CLD=1
reg TEXFLUSH 0
reg TEX1_1 0
reg CLAMP_1 0x0000_0000_0000_0005
reg TEX0_1 0x2000_D00C_9130_4640

