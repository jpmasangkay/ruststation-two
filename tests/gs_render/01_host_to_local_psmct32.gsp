# Step 1 GS Render Gate #1: Host -> Local (`TRXDIR=0`) upload in PSMCT32 via A+D + IMAGE GIF packets.
surface 0 1 PSMCT32 8 4

# A+D GIFtag (NLOOP=4, EOP=1, FLG=PACKED, NREGS=1, REGS=0xE A+D)
qwc 0x1000_0000_0000_8004 0x0000_0000_0000_000E
# BITBLTBUF: DBP=0, DBW=1 (64 px), DPSM=0 (PSMCT32)
qwc 0x0001_0000_0000_0000 0x50
# TRXPOS: DSAX=2, DSAY=1
qwc 0x0001_0002_0000_0000 0x51
# TRXREG: RRW=4, RRH=2
qwc 0x0000_0002_0000_0004 0x52
# TRXDIR: 0 (Host -> Local)
qwc 0x0000_0000_0000_0000 0x53

# IMAGE GIFtag (NLOOP=2, EOP=1, FLG=IMAGE): 2 QWC = 8 32-bit pixels (row y=1 then y=2)
qwc 0x0800_0000_0000_8002 0x0000_0000_0000_0000
qwc32 0xAA00_0001 0xAA00_0002 0xAA00_0003 0xAA00_0004
qwc32 0xAA00_0005 0xAA00_0006 0xAA00_0007 0xAA00_0008
